<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_certificado_recaudos"
        model="report.paperformat">
        <field name="name">European A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_certificado_recaudos" model="ir.actions.report">
        <field name="name">Certificado de Recaudos</field>
        <field name="model">ctm.movimientos_flujos</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ctm_control_movimientos.ctm_certificado_recaudos</field>
        <field name="paperformat_id" ref="paperformat_certificado_recaudos" />
        <field name="binding_model_id" ref="ctm_control_movimientos.model_ctm_movimientos_flujos" />
        <field name="binding_type">report</field>
    </record>
    <template id="ctm_certificado_recaudos">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <table  style="border-collapse: collapse; border: 0.5px solid;width: 100%;">
                        <thead class="text-center" style="background-color: #619f11; color: white;">
                            <tr>
                                <th style="border: 0.5px solid; width:20%; vertical-align: middle;">Inversionista</th>
                                <th style="border: 0.5px solid; width:20%; vertical-align: middle;"><t t-esc="docs[0].partner_id.name"/></th>
                                <th style="border: 0.5px solid; background-color:white; vertical-align: middle;" colspan="4" rowspan="3">
                                    <img src='/ctm_control_movimientos/static/images/icon_report.png' style="width: 100%;"/>
                                </th>
                            </tr>
                            <tr>
                                <th style="border: 0.5px solid; vertical-align: middle;">Movimientos de Aplicación de Recaudo</th>
                                <th style="border: 0.5px solid; vertical-align: middle;"><t t-esc="docs[0].gestor_id.name"/> - <t t-esc="docs[0].investment_type_id.name"/></th>
                            </tr>
                            <tr>
                                <th style="border: 0.5px solid; vertical-align: middle;">Fecha</th>
                                <th style="border: 0.5px solid; vertical-align: middle;"><t t-esc="docs[0].fecha_final"/></th>
                            </tr>
                            <tr>
                                <th style="border: 0.5px solid; vertical-align: middle;">Emisor</th>
                                <th style="border: 0.5px solid; vertical-align: middle;">Pagador</th>
                                <th style="border: 0.5px solid; width:8%; vertical-align: middle;"># Título</th>
                                <th style="border: 0.5px solid; width:11%; vertical-align: middle;">Rendimientos</th>
                                <th style="border: 0.5px solid; width:11%; vertical-align: middle;">Capital</th>
                                <th style="border: 0.5px solid; width:23%; vertical-align: middle;">Total de Aplicación de Recaudo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td style="border: 0.5px solid;">
                                    <t t-if="doc.tipo == 'compra'">
                                        <t t-esc="doc.compra_id.emisor_id.name"/>
                                    </t>
                                    <t t-if="doc.tipo == 'aplicación'">
                                        <t t-esc="doc.aplicacion_id.emisor_id.name"/>
                                    </t>
                                </td>
                                <td style="border: 0.5px solid;">
                                    <t t-if="doc.tipo == 'compra'">
                                        <t t-esc="doc.compra_id.pagador_id.name"/>
                                    </t>
                                    <t t-if="doc.tipo == 'aplicación'">
                                        <t t-esc="doc.aplicacion_id.pagador_id.name"/>
                                    </t>
                                </td>
                                <td style="border: 0.5px solid;">
                                    <t t-if="doc.tipo == 'compra'">
                                        <t t-esc="doc.compra_id.titulo_id"/>
                                    </t>
                                    <t t-if="doc.tipo == 'aplicación'">
                                        <t t-esc="doc.aplicacion_id.titulo_id"/>
                                    </t>
                                </td>
                                <td style="border: 0.5px solid;" class="text-right"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-field="doc.pago_rendimientos"/></td>
                                <td style="border: 0.5px solid;" class="text-right"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-field="doc.pago_capital"/></td>
                                <td style="border: 0.5px solid;" class="text-right"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-esc="doc.pago_rendimientos + doc.pago_capital"/></td>
                            </tr>
                            <tr>
                                <td style="border: 0.5px solid;"></td>
                                <td style="border: 0.5px solid;"></td>
                                <td style="border: 0.5px solid;" class="text-right">TOTAL</td>
                                <td style="border: 0.5px solid;" class="text-left"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-esc="sum(doc.pago_rendimientos for doc in docs)"/></td>
                                <td style="border: 0.5px solid;" class="text-left"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-esc="sum(doc.pago_capital for doc in docs)"/></td>
                                <td style="border: 0.5px solid;" class="text-left"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-esc="sum(doc.pago_rendimientos + doc.pago_capital for doc in docs)"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
