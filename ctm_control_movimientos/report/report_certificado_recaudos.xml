<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_certificado_recaudos" model="ir.actions.report">
        <field name="name">Certificado de Recaudos</field>
        <field name="model">ctm.movimientos_flujos</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ctm_control_movimientos.ctm_certificado_recaudos</field>
        <field name="binding_model_id" ref="ctm_control_movimientos.model_ctm_movimientos_flujos" />
        <field name="binding_type">report</field>
    </record>
    <template id="ctm_certificado_recaudos">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <table  style="border-collapse: collapse; border: 0.5px solid;width: 100%;">
                        <thead class="text-center" style="background-color: #619f11; color: white;">
                            <tr>
                                <th style="border: 0.5px solid; width:30%;">Inversionista</th>
                                <th style="border: 0.5px solid; width:30%;"><t t-esc="docs[0].partner_id.name"/></th>
                                <th style="border: 0.5px solid;" COLSPAN="4"></th>
                            </tr>
                            <tr>
                                <th style="border: 0.5px solid;">Movimientos de Aplicación de Recaudo</th>
                                <th style="border: 0.5px solid;"><t t-esc="docs[0].gestor_id.name"/> - <t t-esc="docs[0].investment_type_id.name"/></th>
                                <th style="border: 0.5px solid;" COLSPAN="4"></th>
                            </tr>
                            <tr>
                                <th style="border: 0.5px solid;">Fecha</th>
                                <th style="border: 0.5px solid;"><t t-esc="docs[0].fecha_final"/></th>
                                <th style="border: 0.5px solid;" COLSPAN="4"></th>
                            </tr>
                            <tr>
                                <th style="border: 0.5px solid;">Emisor</th>
                                <th style="border: 0.5px solid;">Pagador</th>
                                <th style="border: 0.5px solid; width:10%;"># Título</th>
                                <th style="border: 0.5px solid; width:13%;">Rendimientos</th>
                                <th style="border: 0.5px solid; width:13%;">Capital</th>
                                <th style="border: 0.5px solid; width:13%;">Total de Aplicación de Recaudo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td style="border: 0.5px solid;">
                                    <t t-if="doc.tipo == 'compra'">
                                        <t t-esc="doc.compra_id.emisor_id.name"/>
                                    </t>
                                    <t t-if="doc.tipo == 'aplicación'">
                                        <t t-esc="doc.aplicacion_id.emisor_id.name"/>
                                    </t>
                                </td>
                                <td style="border: 0.5px solid;">
                                    <t t-if="doc.tipo == 'compra'">
                                        <t t-esc="doc.compra_id.pagador_id.name"/>
                                    </t>
                                    <t t-if="doc.tipo == 'aplicación'">
                                        <t t-esc="doc.aplicacion_id.pagador_id.name"/>
                                    </t>
                                </td>
                                <td style="border: 0.5px solid;">
                                    <t t-if="doc.tipo == 'compra'">
                                        <t t-esc="doc.compra_id.titulo_id"/>
                                    </t>
                                    <t t-if="doc.tipo == 'aplicación'">
                                        <t t-esc="doc.aplicacion_id.titulo_id"/>
                                    </t>
                                </td>
                                <td style="border: 0.5px solid;"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-field="doc.pago_rendimientos"/></td>
                                <td style="border: 0.5px solid;"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-field="doc.pago_capital"/></td>
                                <td style="border: 0.5px solid;"><span t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}" t-esc="doc.pago_rendimientos + doc.pago_capital"/></td>
                            </tr>
                            <tr>
                                <td style="border: 0.5px solid;"></td>
                                <td style="border: 0.5px solid;"></td>
                                <td style="border: 0.5px solid;"></td>
                                <td style="border: 0.5px solid;">TOTAL</td>
                                <td style="border: 0.5px solid;">0</td>
                                <td style="border: 0.5px solid;">0</td>
                                <td style="border: 0.5px solid;">0</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
