<odoo>
    <record id="view_ctm_flujos_tree" model="ir.ui.view">
        <field name="name">ctm.flujos.tree</field>
        <field name="model">ctm.flujos</field>
        <field name="arch" type="xml">
            <tree string="Flujos">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="flujo" widget="percentage"/>
                <field name="cdg" widget="percentage"/>
            </tree>
        </field>
    </record>

    <record id="view_ctm_flujos_form" model="ir.ui.view">
        <field name="name">ctm.flujos.form</field>
        <field name="model">ctm.flujos</field>
        <field name="arch" type="xml">
            <form string="Flujos">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="tipo" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="flujo" widget="percentage" readonly="1"/>
                        <field name="cdg" widget="percentage" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="movimientos_flujo" string="Movimientos Flujo">
                            <field name="movimientos_flujo_ids" readonly="1">
                                <tree editable="bottom">
                                    <field name="fecha_inicial" optional="show"/>
                                    <field name="fecha_final" optional="show"/>
                                    <field name="tipo"/>
                                    <field name="compra" optional="show"/>
                                    <field name="rendimiento" optional="show"/>
                                    <field name="rendimiento_acumulado" optional="show"/>
                                    <field name="cdg" optional="show"/>
                                    <field name="cdg_acumulado" optional="show"/>
                                    <field name="pago_otros_conceptos" optional="show"/>
                                    <field name="pago_cdg" optional="show"/>
                                    <field name="pago_rendimientos" optional="show"/>
                                    <field name="pago_capital" optional="show"/>
                                    <field name="valor_activo" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>