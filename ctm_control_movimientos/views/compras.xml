<odoo>
    <record id="view_ctm_compras_tree" model="ir.ui.view">
        <field name="name">ctm.compras.tree</field>
        <field name="model">ctm.compras</field>
        <field name="arch" type="xml">
            <tree string="Compras">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="fecha"/>
                <field name="investment_type_id"/>
                <field name="gestor_id"/>
                <field name="valor"/>
                <field name="flujo" widget="percentage"/>
                <field name="cdg" widget="percentage"/>
            </tree>
        </field>
    </record>

    <record id="view_ctm_compras_form" model="ir.ui.view">
        <field name="name">ctm.compras.form</field>
        <field name="model">ctm.compras</field>
        <field name="arch" type="xml">
            <form string="Compras">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="fecha"/>
                        <field name="investment_type_id"/>
                        <field name="gestor_id"/>
                    </group>
                    <group>
                        <field name="valor"/>
                        <field name="flujo" widget="percentage"/>
                        <field name="cdg" widget="percentage"/>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>
</odoo>