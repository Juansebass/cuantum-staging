<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="model_valor_portafolio_view_form" model="ir.ui.view">
        <field name="name">ctm.valor_portafolio.view.form</field>
        <field name="model">ctm.valor_portafolio</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="crear_valor_portafolio" type="object" string="Crear Valor Portafolio" attrs="{'invisible': [('state', 'in', ['draft'])]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <h3 style="display: flex;"><field name="name" readonly="1" class="oe_inline"/></h3>
                        </div>
                    </div>
                    <group name="Usuario">
                        <group name="izquierda">
                            <field name="fecha_corte" />
                            <field name="responsible" readonly="1"/>
                        </group>
                        <group name="derecha">
                            <field name="client_file" widget="binary"/>
                            <field name="delimiter" />
                            <field name="skip_first_line" />
                            <button name='action_cargar_clientes' type="object"
                                                            string="Cargar Clientes"
                                                            class="oe_stat_button"
                                                            icon="fa-refresh"/>
                        </group>
                    </group>
                </sheet>
                <notebook>
                    <page string="Clientes" >
                        <tree string="Clientes" editable="bottom" >
                            <field name="cliente_ids"/>
                        </tree>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="model_ctm_valor_portafolio_view_tree" model="ir.ui.view">
        <field name="name">ctm.valor_portafolio.view.tree</field>
        <field name="model">ctm.valor_portafolio</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name" />
            </tree>
        </field>
    </record>
</odoo>