<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="model_ctm_valoracion_6_4_view_tree" model="ir.ui.view">
        <field name="name">ctm.valoracion_6_4.view.tree</field>
        <field name="model">ctm.valoracion_6_4</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name" />
                <field name="fecha_compra" />
                <field name="fecha_liquidar" />
                <field name="fecha_vencimiento" />
                <field name="vehiculo"/>
                <field name="emisor" />
                <field name="pagador" />
                <field name="valor_giro" />
                <field name="valor_condena" />
                <field name="total_intereses" />
                <field name="resultado" />
                <field name="tir_compra_6_4" />
            </tree>
        </field>
    </record>

    <record id="model_ctm_valoracion_6_4_view_form" model="ir.ui.view">
        <field name="name">ctm.valoracion_6_4.view.form</field>
        <field name="model">ctm.valoracion_6_4</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="set_borrador_valoracion" type="object" string="Pasar a borrador" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button name="generar_simulacion" type="object" string="Generar Simulación" attrs="{'invisible': [('state', 'not in', ['amortizado'])]}"/>
                    <button name="action_view_simulaciones"
                            type="object"
                            string="Simulaciones"
                            class="oe_stat_button"
                            icon="fa-calculator"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <h3 style="display: flex;"><field name="name" readonly="1" class="oe_inline"/></h3>
                        </div>
                    </div>
                    <group name="cliente">
                        <group name="izquierda">
                            <field name="sentencia" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"/>
                            <field name="emisor" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"
                                   options='{"always_reload": True, "no_quick_create": True, "no_create_edit": True,
                                            "no_create":True, "no_open":True}'
                            />
                            <field name="pagador" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"
                                   options='{"always_reload": True, "no_quick_create": True, "no_create_edit": True,
                                            "no_create":True, "no_open":True}'
                            />
                            <field name="codigo" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"/>
                            <field name="fecha_ejecutoria" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"/>
                            <field name="fecha_cuenta_cobro" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"/>
                            <field name="fecha_compra"/>
                            <field name="fecha_liquidar"/>
                            <field name="fecha_vencimiento"/>
                        </group>
                        <group name="derecha">
                            <field name="valor_actual_6_4" readonly="1"/>
                            <field name="valor_giro" readonly="1"/>
                            <field name="valor_condena" attrs="{'readonly': [('state', 'in', ['liquidated', 'draft'])]}"/>
                            <field name="total_intereses" readonly="1"/>
                            <field name="valor_contable_ayer" readonly="1"/>
                            <field name="precio" readonly="1"/>
                            <field name="resultado" readonly="1"/>
                            <field name="tir_compra_6_4" readonly="1"/>
                            <field name="responsible" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="valoracion_64_resumen" string="Resumen">
                            <field name="valoraciones_resumen_ids" readonly="1">
                                <tree editable="bottom">
                                    <field name="fecha"/>
                                    <field name="tasa"/>
                                    <field name="interes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="create_valoracion_6_4_txt_action" model="ir.actions.server">
        <field name="name">Crear TXT</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_ctm_valoracion_6_4"/>
        <field name="binding_model_id" ref="model_ctm_valoracion_6_4" />
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.create_txt()
        </field>
    </record>

    <record id="create_valoracion_6_4_excel_action" model="ir.actions.server">
        <field name="name">Crear Excel Compra</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_ctm_valoracion_6_4"/>
        <field name="binding_model_id" ref="model_ctm_valoracion_6_4" />
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.create_excel()
        </field>
    </record>

    <record id="create_valoracion_6_4_excel_valoracion_action" model="ir.actions.server">
        <field name="name">Crear Excel Valoración</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_ctm_valoracion_6_4"/>
        <field name="binding_model_id" ref="model_ctm_valoracion_6_4" />
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.create_excel_valoracion()
        </field>
    </record>

    <record id="generate_valoracion_6_4_simulations_action" model="ir.actions.server">
        <field name="name">Generar Simulaciones</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_ctm_valoracion_6_4"/>
        <field name="binding_model_id" ref="model_ctm_valoracion_6_4" />
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.generate_simulations()
        </field>
    </record>

    <record id="model_crear_valoracion_6_4_view_form" model="ir.ui.view">
        <field name="name">ctm.crear.valoracion_6_4.view.form</field>
        <field name="model">ctm.crear_valoracion_6_4</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="crear_valoraciones" type="object" string="Crear Valoraciones 6.4" attrs="{'invisible': [('status', 'in', ['creados'])]}"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="o_row">
                            <h3 style="display: flex;"><field name="name" readonly="1" class="oe_inline"/></h3>
                        </div>
                    </div>
                    <group name="Usuario">
                        <group name="izquierda">
                            <field name="month" />
                            <field name="year" />
                            <field name="responsible" />
                            <field name="status" readonly="1"/>
                        </group>
                        <group name="derecha">
                            <field name="client_file" widget="binary"/>
                            <field name="delimiter" />
							<field name="skip_first_line" />
                            <button name='action_cargar_sentencias' type="object"
                                                            string="Cargar Sentencias"
                                                            class="oe_stat_button"
                                                            icon="fa-refresh"/>
                        </group>
                    </group>
                </sheet>
                <field name="valoracion_6_4_ids">
                    <tree string="Sentencias" editable="bottom" >
                        <field name="sentencia" />
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record id="model_ctm_crear_valoracion_6_4_view_tree" model="ir.ui.view">
        <field name="name">ctm.crear.valoracion_6_4.view.tree</field>
        <field name="model">ctm.crear_valoracion_6_4</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="liquidacion_simulacion_view_tree" model="ir.ui.view">
        <field name="name">ctm.valoracion_simulacion.tree</field>
        <field name="model">ctm.valoracion_simulacion</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="fecha_compra"/>
                <field name="fecha_vencimiento"/>
                <field name="fecha_liquidar"/>
                <field name="valor_condena"/>
                <field name="total_intereses"/>
                <field name="valor_giro"/>
                <field name="resultado"/>
                <field name="valor_actual_6_4"/>
                <field name="tir_compra_6_4"/>
            </tree>
        </field>
    </record>

</odoo>