<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_ctm_proyecciones_form" model="ir.ui.view">
        <field name="name">ctm.proyecciones.form</field>
        <field name="model">ctm.proyecciones</field>
        <field name="arch" type="xml">
            <form string="Proyecciones">
                <header>
                    <button name="calcular_proyeccion" type="object" string="Calcular Proyección"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"  readonly="1"/>
                        <field name="sentencia_id"/>
                        <field name="retencion_total"/>
                        <field name="intermediacion"/>
                        <field name="comision_interna"/>
                        <field name="estructuracion"/>
                        <field name="ingreso_anticipado_cuantum"/>
                        <field name="valor_descuento_diluido"/>
                        <field name="valor_compra_beneficiario"/>
                        <field name="valor_venta_inversionista"/>
                        <field name="total_descuentos"/>
                        <field name="porcentaje_total_descuentos" widget="percentage"/>
                        <field name="total_descuentos_gastos"/>
                        <field name="porcentaje_total_descuentos_gastos" widget="percentage"/>
                    </group>
                    <group string="TIR">
                        <field name="tir_optimista"/>
                        <field name="tir_neutral"/>
                        <field name="tir_acido"/>
                        <field name="tir_compra"/>
                    </group>

                    <group string="Valor Esperado">
                        <field name="valor_esperado_optimista"/>
                        <field name="valor_esperado_neutral"/>
                        <field name="valor_esperado_acido"/>
                        <field name="valor_esperado_compra"/>
                    </group>
                    <notebook>
                        <page name="liquidacion_inicial" string="Liquidación Inicial">
                            <group>
                                <field name="valor_condena"/>
                                <field name="total_intereses"/>
                                <field name="resultado"/>
                            </group>
                            <field name="liquidacion_inicial_ids" readonly="1">
                                <tree editable="bottom">
                                    <field name="fecha"/>
                                    <field name="tasa"/>
                                    <field name="interes"/>
                                    <field name="interes_acumulado"/>
                                    <field name="resultado"/>
                                </tree>
                            </field>
                        </page>
                        <page name="proyeccion_venta" string="Proyección para Venta">
                            <field name="proyeccion_venta_ids" readonly="1">
                                <tree editable="bottom">
                                    <field name="fecha_inicial"/>
                                    <field name="fecha_final"/>
                                    <field name="tasa"/>
                                    <field name="interes"/>
                                    <field name="descuento_diluido"/>
                                    <field name="rendimientos_totales"/>
                                    <field name="valor_antes_cdg"/>
                                    <field name="valor_comision_gestion"/>
                                    <field name="valor_esperado"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ctm_proyecciones_tree" model="ir.ui.view">
        <field name="name">ctm.proyecciones.tree</field>
        <field name="model">ctm.proyecciones</field>
        <field name="arch" type="xml">
            <tree string="Proyecciones">
                <field name="name" optional="show" readonly="1"/>
                <field name="sentencia_id" optional="show"/>
                <field name="retencion_total" optional="hide"/>
                <field name="intermediacion" optional="hide"/>
                <field name="estructuracion" optional="hide"/>
                <field name="valor_descuento_diluido" optional="hide"/>
                <field name="valor_compra_beneficiario" optional="hide"/>
                <field name="valor_venta_inversionista" optional="hide"/>
                <field name="total_descuentos" optional="hide"/>
                <field name="porcentaje_total_descuentos" optional="hide"/>
                <field name="total_descuentos_gastos" optional="hide"/>
                <field name="porcentaje_total_descuentos_gastos" optional="hide"/>
                <field name="tir_optimista" optional="hide"/>
                <field name="tir_neutral" optional="hide"/>
                <field name="tir_acido" optional="hide"/>
                <field name="tir_compra" optional="hide"/>
            </tree>
        </field>
    </record>
</odoo>