<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="model_ctm_sentencias_view_form" model="ir.ui.view">
        <field name="name">ctm.sentencias.view.form</field>
        <field name="model">ctm.sentencias</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="generar_proyeccion" type="object" string="Generar Proyección" attrs="{'invisible': ['|', ('vehiculo_name', '!=', 'CSF'), ('state', '=', 'venta_completa')]}"/>
                    <button name="tir_deseada" type="object" string="TIR Deseada"/>
                    <button name="action_view_proyecciones"
                            type="object"
                            string="Proyecciones"
                            class="oe_stat_button"
                            icon="fa-calculator"
                            attrs="{'invisible': [('vehiculo_name', '!=', 'CSF')]}"
                    />
                    <button name="vendida"
                            type="object"
                            string="Vendida"
                            attrs="{'invisible': [('state', '!=', 'proyeccion')]}"
                    />

                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group name="izquierda">
                        <field name="name"/>
                        <field name="emisor"
                            options='{"always_reload": True, "no_quick_create": True, "no_create_edit": True,
                                        "no_create":True, "no_open":True}'
                        />
                        <field name="pagador"
                            options='{"always_reload": True, "no_quick_create": True, "no_create_edit": True,
                                        "no_create":True, "no_open":True}'
                        />
                        <field name="codigo"/>
                        <field name="vehiculo" string="Vehículo"/>
                        <field name="vehiculo_name" invisible="1"/>
                        <field name="nit_fcp_statum" string="NIT Vehículo"/>
                        <field name="vendedor"  attrs="{'invisible': [('vehiculo_name', '=', 'CSF')]}"/>
                        <field name="nemotecnico" attrs="{'invisible': [('vehiculo_name', '=', 'CSF')]}"/>
                    </group>
                    <group name="derecha">
                        <field name="fecha_ejecutoria"/>
                        <field name="fecha_cuenta_cobro"/>
                        <field name="fecha_compra"/>
                        <field name="fecha_liquidar"/>
                        <field name="fecha_vencimiento" attrs="{'invisible': [('vehiculo_name', '=', 'CSF')]}"/>
                        <field name="valor_giro" attrs="{'invisible': [('vehiculo_name', '=', 'CSF')]}"/>
                        <field name="comision" attrs="{'invisible': [('vehiculo_name', '=', 'CSF')]}"/>
                        <field name="valor_condena"/>
                        <field name="costas"/>
                    </group>
                    <notebook>
                        <page string="Datos Compraventa" attrs="{'invisible': [('vehiculo_name', '!=', 'CSF')]}">
                            <group string="Descuentos">
                                <field name="retencion_total" widget="percentage" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                                <field name="estructuracion" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                                <field name="intermediacion" widget="percentage" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                                <field name="comision_interna" widget="percentage" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                                <field name="descuento_diluido" widget="percentage" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                                <field name="ingreso_anticipado_cuantum" widget="percentage" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                                <field name="comision_gestion_cuantum" widget="percentage" attrs="{'readonly': [('state', '=', 'venta_completa')]}"/>
                            </group>
                            <group string="Fechas a Liquidar">
                                <field name="fecha_liquidar_optimista"/>
                                <field name="fecha_liquidar_neutral"/>
                                <field name="fecha_liquidar_acido"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="model_ctm_sentencias_view_tree" model="ir.ui.view">
        <field name="name">ctm.sentencias.view.tree</field>
        <field name="model">ctm.sentencias</field>
        <field name="arch" type="xml">
            <tree string="Sentencias">
                <field name="name"/>
                <field name="vehiculo"/>
                <field name="pagador"/>
                <field name="codigo"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="generar_proyecciones_action" model="ir.actions.server">
        <field name="name">Generar Proyecciones</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_ctm_sentencias"/>
        <field name="binding_model_id" ref="model_ctm_sentencias" />
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.generar_proyecciones()
        </field>
    </record>
</odoo>