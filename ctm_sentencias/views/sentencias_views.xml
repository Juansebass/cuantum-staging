<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="model_ctm_sentencias_view_form" model="ir.ui.view">
        <field name="name">ctm.sentencias.view.form</field>
        <field name="model">ctm.sentencias</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="generar_proyeccion" type="object" string="Generar Proyección" attrs="{'invisible': [('statum', '!=', 'CSF')]}"/>
                    <button name="action_view_proyecciones"
                            type="object"
                            string="Proyecciones"
                            class="oe_stat_button"
                            icon="fa-calculator"
                            attrs="{'invisible': [('statum', '!=', 'CSF')]}"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group name="izquierda">
                        <field name="name"/>
                        <field name="emisor"
                            options='{"always_reload": True, "no_quick_create": True, "no_create_edit": True,
                                        "no_create":True, "no_open":True}'
                        />
                        <field name="pagador"
                            options='{"always_reload": True, "no_quick_create": True, "no_create_edit": True,
                                        "no_create":True, "no_open":True}'
                        />
                        <field name="codigo"/>
                        <field name="statum"/>
                        <field name="nit_fcp_statum"/>
                        <field name="vendedor"  attrs="{'invisible': [('statum', '=', 'CSF')]}"/>
                        <field name="nemotecnico" attrs="{'invisible': [('statum', '=', 'CSF')]}"/>
                    </group>
                    <group name="derecha">
                        <field name="fecha_ejecutoria"/>
                        <field name="fecha_cuenta_cobro"/>
                        <field name="fecha_compra"/>
                        <field name="fecha_liquidar"/>
                        <field name="fecha_vencimiento" attrs="{'invisible': [('statum', '=', 'CSF')]}"/>
                        <field name="valor_giro" attrs="{'invisible': [('statum', '=', 'CSF')]}"/>
                        <field name="comision" attrs="{'invisible': [('statum', '=', 'CSF')]}"/>
                        <field name="valor_condena"/>
                        <field name="costas"/>
                    </group>
                    <notebook>
                        <page string="Datos Compraventa" attrs="{'invisible': [('statum', '!=', 'CSF')]}">
                            <group string="Descuentos">
                                <field name="retencion_total" widget="percentage"/>
                                <field name="estructuracion"/>
                                <field name="intermediacion" widget="percentage"/>
                                <field name="descuento_diluido" widget="percentage"/>
                                <field name="ingreso_anticipado_cuantum" widget="percentage"/>
                                <field name="comision_gestion_cuantum" widget="percentage"/>
                            </group>
                            <group string="Fechas a Liquidar">
                                <field name="fecha_liquidar_optimista"/>
                                <field name="fecha_liquidar_neutral"/>
                                <field name="fecha_liquidar_acido"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="model_ctm_sentencias_view_tree" model="ir.ui.view">
        <field name="name">ctm.sentencias.view.tree</field>
        <field name="model">ctm.sentencias</field>
        <field name="arch" type="xml">
            <tree string="Sentencias">
                <field name="name"/>
                <field name="statum"/>
            </tree>
        </field>
    </record>
</odoo>