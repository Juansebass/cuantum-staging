<odoo>
    <!-- Tree View for ctm.pagadores -->
    <record id="view_ctm_codigo_liquidacion_tree" model="ir.ui.view">
        <field name="name">ctm.codigo_liquidacion.tree</field>
        <field name="model">ctm.codigo.liquidacion</field>
        <field name="arch" type="xml">
            <tree string="Códigos">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_ctm_codigo_liquidacion_form" model="ir.ui.view">
        <field name="name">ctm.codigo_liquidacion.form</field>
        <field name="model">ctm.codigo.liquidacion</field>
        <field name="arch" type="xml">
            <form string="Código">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>