<odoo>
    <record id="view_tir_deseada_wizard_form" model="ir.ui.view">
        <field name="name">tir.deseada.wizard.form</field>
        <field name="model">ctm.tir_deseada.wizard</field>
        <field name="arch" type="xml">
            <form string="TIR Deseada Wizard">
                <group>
                    <field name="tir_deseada"/>
                </group>
                <footer>
                    <button string="Calcular TIR Deseada" type="object" name="action_set_tir_deseada" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tir_deseada_wizard" model="ir.actions.act_window">
        <field name="name">TIR Deseada Wizard</field>
        <field name="res_model">ctm.tir_deseada.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>